{
  "name": "VYNDI OS development (no deployment)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "VYNDI OS local preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode"
      ]
    }
  }
}
