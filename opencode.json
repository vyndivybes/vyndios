{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "enabled": true
    },
    "stitch": {
      "type": "remote",
      "url": "{env:STITCH_MCP_URL}",
      "enabled": false
    }
  }
}
